# Copy to docker/.env and fill in your dev/test credentials.
# Use the JDBC host, port and username from your Supabase connection settings.
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres
DB_SSL_MODE=require
SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_USERNAME
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD
APP_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_WEB_ORIGIN=http://localhost:5173

# VNPay Sandbox only; obtain merchant credentials from VNPay. Never expose as VITE_*.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/member/payments/vnpay/return
VNPAY_TIMEOUT_MINUTES=15
