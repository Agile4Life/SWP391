# Supabase Dashboard > Connect > Session pooler (port 5432).
# Fill in the JDBC URL; keep the database password separate from the URL.
SPRING_PROFILES_ACTIVE=supabase
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
DB_SSL_MODE=require
# For verified TLS, set DB_SSL_MODE=verify-full and provide the downloaded CA path.
DB_SSL_ROOT_CERT=
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
SPRING_JPA_HIBERNATE_DDL_AUTO=update
VITE_API_BASE_URL=http://localhost:8080/api/v1
APP_JWT_SECRET=
# Optional first Admin; use a new email. Managers are created inside the Admin portal.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
# Optional integration tests: use a dedicated Supabase dev/test session pooler.
# Keep TLS settings separate: the test JDBC URL must not contain sslmode or credentials.
SCMS_POSTGRES_TEST_URL=
SCMS_POSTGRES_TEST_USERNAME=
SCMS_POSTGRES_TEST_PASSWORD=
APP_OTP_DELIVERY=disabled
APP_AUTH_DEBUG_OTP_ENABLED=false
# Resend HTTP API: set APP_OTP_DELIVERY=resend and provide RESEND_API_KEY (starts with re_).
RESEND_API_KEY=
RESEND_FROM="SÖL Fitness <no-reply@scms.bluesymphony.site>"
# Google OAuth Client ID & Secret for SCRUM-89 Google Login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
# Use the same OAuth web client ID in the frontend build.
VITE_GOOGLE_CLIENT_ID=
# Optional separate QR signing key; unset reuses the required private APP_JWT_SECRET.
# APP_QR_SECRET=
APP_QR_TTL_SECONDS=60

# Public Supabase Realtime connection; never use service_role/secret keys here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only: project legacy HS256 JWT secret still trusted by Supabase.
# Not APP_JWT_SECRET, not an API key. Leave empty to disable private chat Realtime.
# Never use VITE_ prefix or commit an actual value. See docs/setup/direct-chat.md.
SUPABASE_CHAT_JWT_SECRET=

# Free Cloud LLM + DB RAG configuration (gemini = Google AI Studio Free Tier, groq = Groq Cloud Free Tier)
SCMS_AI_PROVIDER=gemini
SCMS_AI_API_KEY=
SCMS_AI_MODEL=gemini-3-flash-preview

# VNPay Sandbox only; obtain merchant credentials from VNPay. Never expose as VITE_*.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/member/payments/vnpay/return
VNPAY_TIMEOUT_MINUTES=15
