        <mxCell id="hdr_sub" value="Vai trò: COACH | Mặc định sau đăng nhập: /staff/attendance | Quản lý lịch dạy, điểm danh và soạn giáo án với AI" style="text;html=1;fontFamily=Plus Jakarta Sans,Helvetica,Arial,sans-serif;fontSize=12;fontStyle=2;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontColor=#64748b;convertToSvg=1;" vertex="1" parent="1">
