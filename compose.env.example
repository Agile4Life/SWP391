# Copy to .env on a fresh checkout. Keep an existing .env and merge these settings.
# WEB_PORT is the host port; the API is reachable only inside the Compose network.
WEB_PORT=8080
WEB_BIND_ADDRESS=0.0.0.0

# Supabase Dashboard > Connect > Session pooler (port 5432).
# Fill in the real JDBC URL, username and password; never put credentials in the URL.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
DB_SSL_MODE=require
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# Generate with: openssl rand -hex 32
APP_JWT_SECRET=

# Replace localhost with the public server IP/domain, including scheme and port.
# Update these URLs together when WEB_PORT or the public domain changes.
APP_WEB_ORIGIN=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
VNPAY_RETURN_URL=http://localhost:8080/member/payments/vnpay/return

# Optional first Admin. Leave empty if the database already has an Admin.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Email OTP & notifications via Resend: set APP_OTP_DELIVERY=resend and fill RESEND_API_KEY.
APP_OTP_DELIVERY=disabled
APP_AUTH_DEBUG_OTP_ENABLED=false
RESEND_API_KEY=
RESEND_FROM="SÖL Fitness <no-reply@scms.bluesymphony.site>"

# Public OAuth client ID is embedded in the web image; rebuild web after changing it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Optional Supabase Realtime. Never use service_role/secret keys as publishable keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_CHAT_JWT_SECRET=

# Existing mock AI implementation; no real provider is required by Compose.
SCMS_AI_PROVIDER=mock
SCMS_AI_CHAT_PROVIDER=mock

# VNPay Sandbox only. Enable after configuring merchant credentials and public URLs.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_TIMEOUT_MINUTES=15
