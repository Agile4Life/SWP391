erDiagram
  direction LR
  member_addresses {
    bigint id PK
    bigint member_id FK
    varchar_80 recipient_name
    varchar_15 phone
    varchar_10 province_code
    varchar_80 province_name
    varchar_10 ward_code
    varchar_80 ward_name
    varchar_200 street_line
    varchar_200 note
    boolean is_default
    timestamp created_at
    timestamp updated_at
  }
  members {
    bigint user_id PK,FK,UK
  }
  product_categories {
    bigint id PK
    varchar_80 name UK
    varchar_80 slug UK
    integer sort_order
    boolean active
    timestamp created_at
  }
  product_goals {
    bigint product_id FK
    varchar_30 goal
  }
  product_images {
    bigint id PK
    bigint product_id FK
    text data_url
    varchar_20 content_type
    varchar_160 alt_text
    integer sort_order
    timestamp created_at
  }
  product_nutrients {
    bigint id PK
    bigint product_id FK
    varchar_80 name
    numeric_10_2 amount
    varchar_12 unit
    integer daily_value_percent
    boolean sub_row
    boolean highlight
    integer sort_order
  }
  product_order_items {
    bigint id PK
    bigint order_id FK
    bigint variant_id FK
    varchar_160 product_name
    varchar_80 variant_label
    varchar_40 sku
    numeric_12_2 unit_price
    integer quantity
    numeric_12_2 line_total
  }
  product_orders {
    bigint id PK
    varchar_20 code UK
