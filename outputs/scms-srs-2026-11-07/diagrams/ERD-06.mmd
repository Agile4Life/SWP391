    varchar_200 ship_note
    timestamp payment_due_at
    timestamp paid_at
    timestamp processing_at
    timestamp shipped_at
    timestamp ready_at
    timestamp completed_at
    timestamp cancelled_at
    varchar_255 cancel_reason
    bigint cancelled_by_id FK
    varchar_60 tracking_carrier
    varchar_60 tracking_number
    timestamp created_at
    timestamp updated_at
  }
  product_stock_movements {
    bigint id PK
    bigint variant_id FK
    integer delta
    varchar_20 reason
    bigint order_id
    varchar_200 note
    bigint actor_id FK
    timestamp created_at
  }
  product_variants {
    bigint id PK
    bigint product_id FK
    varchar_40 sku UK
    varchar_80 label
    numeric_12_2 price
    integer servings_per_container
